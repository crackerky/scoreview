# INTERNAL_API_TOKEN は web と api で同じ値にする。例の値は置かない(リポジトリを読んだ人が
# 知っている値で動かさないため)。`openssl rand -hex 32` で作った値を両方に入れる。

# web(apps/web/.env.local にコピー)
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_API_TOKEN=
# サイトの公開 URL(記録係の画面の送信元の確認に使う)。手元で 3000 以外のポートで動かすときに設定する
PUBLIC_SITE_URL=http://localhost:3000
# 取込データの画像のうち参照サイト(*.clubjr.com、/zfiles/)を指すもの。block(既定)は自作の
# プレースホルダに差し替えて参照サイトに取りに行かない。allow はそのまま出す(見比べるときだけ)
REFERENCE_ASSET_MODE=block

# api(apps/api/.env にコピー)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/scoreview?sslmode=disable
INTERNAL_API_TOKEN=
# 公式 LINE(docs/deploy.md)。チャネル ID とシークレットの両方があるときだけ Webhook を受ける。そのときは
# ベーシック ID(@ から)と、返信に入れるリンクのサイトの URL も要る。本番の公式アカウントの値は入れない
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_BASIC_ID=
PUBLIC_SITE_URL=http://localhost:3000
# 手元で偽の LINE を立てて確かめるときだけ(空なら https://api.line.me)
LINE_API_BASE_URL=

# 予約した公式 LINE の送信を送る定期の呼び出し(web の /cron/notify)の確かめ(docs/deploy.md)。
# 空なら /cron/notify は誰の呼び出しも受けない。手元で試すときは値を入れ、Authorization: Bearer で呼ぶ
CRON_SECRET=
