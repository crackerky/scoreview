# web(apps/web/.env.local にコピー)
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
# 取込データの画像のうち参照サイト(*.clubjr.com、/zfiles/)を指すもの。block(既定)は自作の
# プレースホルダに差し替えて参照サイトに取りに行かない。allow はそのまま出す(見比べるときだけ)
REFERENCE_ASSET_MODE=block

# api(apps/api/.env にコピー)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/scoreview?sslmode=disable
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
